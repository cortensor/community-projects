# Optional overrides. Defaults already point at the free Pollinations
# endpoint — copy this to .env only if you need to change something.
# NEVER put a real API key in this repo.

# PAPER_WATCH_PRESET=openai-compatible
# OPENAI_BASE_URL=https://text.pollinations.ai/openai/v1
# OPENAI_MODEL=openai
# OPENAI_API_KEY=

# Cortensor Portal / Router (pending official coordination):
# CORTENSOR_PORTAL_BASE_URL=
# CORTENSOR_PORTAL_API_KEY=
# CORTENSOR_ROUTER_BASE_URL=
# CORTENSOR_ROUTER_API_KEY=

# OpenRouter :free fallback (needs your own key — not provided here):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-oss-20b:free
# OPENAI_API_KEY=
