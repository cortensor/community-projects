# Copy to .env and fill in only what you have. Never commit a real key.
# Default preset (openai-compatible) needs nothing: Pollinations is keyless.

# Provider preset: openai-compatible | cortensor-portal | cortensor-router
ISSUE_TRIAGE_PRESET=openai-compatible

# OpenAI-compatible endpoint (default: Pollinations free, no key)
OPENAI_BASE_URL=https://text.pollinations.ai/openai/v1
OPENAI_MODEL=openai
OPENAI_API_KEY=

# Cortensor Portal (needs official access coordination; leave empty until then)
CORTENSOR_PORTAL_BASE_URL=
CORTENSOR_PORTAL_API_KEY=
CORTENSOR_MODEL=oss-20b

# Cortensor Router (needs official access coordination; leave empty until then)
CORTENSOR_ROUTER_BASE_URL=
CORTENSOR_ROUTER_API_KEY=

# GitHub (optional for public reads; required for approve --yes to write)
GITHUB_TOKEN=

# Minimum seconds between model calls (Pollinations free tier: 1 reply / 45 s / IP)
ISSUE_TRIAGE_MIN_INTERVAL_SEC=45
