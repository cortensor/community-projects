# OpenMinion runtime isolation (repo-local state, zero global pollution)
OPENMINION_HOME=.
OPENMINION_DATA_ROOT=./.openminion-state

# Provider credentials (read from environment only; never commit real keys)
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# Optional Cortensor Portal / Router credentials
CORTENSOR_API_KEY=
CORTENSOR_PORTAL_URL=
CORTENSOR_ROUTER_URL=http://127.0.0.1:8080/api/v2/completions
