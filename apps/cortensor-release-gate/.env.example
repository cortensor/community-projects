# Optional: Cortensor Portal or direct Router API configuration
# Leave unset when running `--demo-local` (uses built-in local loopback server)
CORTENSOR_API_KEY=
CORTENSOR_API_URL=https://api.cortensor.app/v1
CORTENSOR_MODEL=gpt-oss-20b
CORTENSOR_API_MODE=openai_chat
CORTENSOR_SESSION_ID=1

# Optional: generic OpenAI-compatible provider (Ollama, vLLM, OpenAI, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
