# Cortensor OpenMinion Sentinel configuration template
# Never commit real API keys or private keys.

# Inference provider mode: "cortensor" (Cortensor Router / Completions), "openai" (OpenAI-compatible), or "loopback" (offline demo)
SENTINEL_PROVIDER_MODE=cortensor

# Cortensor Router / API v2 endpoint base URL (OpenMinion OpenAI-compatible or Cortensor REST router)
CORTENSOR_BASE_URL=http://127.0.0.1:8080/api/v2
CORTENSOR_API_KEY=your-cortensor-router-api-key
CORTENSOR_MODEL=gpt-oss-20b
CORTENSOR_SESSION_ID=1

# Optional OpenAI-compatible fallback
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-compatible-key
OPENAI_MODEL=gpt-4o-mini

# Public read-only EVM RPC endpoints (Ethereum & Base Mainnet)
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
