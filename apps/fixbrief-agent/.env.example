# FixBrief provider credentials (only needed for hosted providers).
# The default demo path (Ollama) needs NO credentials at all.
# Copy to .env or export in your shell; never commit real keys.

# Ollama (local, free) — no key required:
#   ollama serve && ollama pull qwen2.5:1.5b

# Hosted providers (pick one, then: fixbrief setup --provider <name>):
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cortensor Portal (hosted Cortensor inference, access coordinated
# with the hackathon team):
CORTENSOR_API_KEY=
