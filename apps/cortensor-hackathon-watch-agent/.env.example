# Copy to .env when you need a non-default provider. Nothing here is
# required for the default (Pollinations free tier, no key).
# NEVER put a real API key in this file or commit one to the repo.

# Provider preset: openai-compatible | cortensor-portal | cortensor-router
HACKATHON_WATCH_PRESET=openai-compatible

# Optional key for a preset that needs one. Read from the environment at
# call time only; the agent never writes it to disk.
HACKATHON_WATCH_API_KEY=

# Cortensor Portal / Router endpoints (only used with those presets;
# access is coordinated with the organisers, TBD).
CORTENSOR_PORTAL_BASE_URL=https://portal.cortensor.network/v1
CORTENSOR_PORTAL_MODEL=openai
CORTENSOR_ROUTER_BASE_URL=https://router.cortensor.network/v1
CORTENSOR_ROUTER_MODEL=openai
