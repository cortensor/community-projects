# Model Provider Configuration
# Supported: local (zero-cost deterministic OpenAI-compatible server), cortensor, openai, openrouter, groq
NOVATRIAGE_PROVIDER=local
NOVATRIAGE_MODEL=novatriage-local-deterministic-v1

# Cortensor Portal / Node (optional hosted path)
# NOVATRIAGE_PROVIDER=cortensor
# CORTENSOR_API_URL=http://127.0.0.1:8080/api/v2/completions
# CORTENSOR_API_KEY=
# CORTENSOR_API_MODE=auto
# CORTENSOR_SESSION_ID=1
# NOVATRIAGE_MODEL=gpt-oss-20b

# OpenAI-compatible endpoint (optional)
# NOVATRIAGE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# NOVATRIAGE_MODEL=gpt-4.1-mini

# Live x402 v2 & On-Chain Preflight Endpoints
NOVATRIAGE_X402_BASE_URL=https://novacraft-x402-api-981337528602.us-central1.run.app
NOVATRIAGE_HTTP_TIMEOUT=10.0
