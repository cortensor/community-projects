# Copy to .env and fill in ONE real provider key (never commit .env!)

# Option 1: Google Gemini free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Option 2: Cortensor Portal (optional; request access via Cortensor Discord)
CORTENSOR_API_KEY=
CORTENSOR_API_URL=https://api.cortensor.app/v1

# Option 3: OpenRouter or Groq
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional runtime selection override
ROUTE_BENCH_PROVIDER=gemini
ROUTE_BENCH_MODEL=gemini-2.5-flash-lite
