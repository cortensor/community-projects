# Copy to .env and fill in. Never commit .env.
# Pick ONE model provider for OpenMinion (configured with `openminion setup`).
# Keyless local option (official OpenMinion Ollama preset, no API key):
#   ollama pull llama3.1
#   openminion setup --provider ollama --model llama3.1 --agent radar --no-chat
# Cortensor Portal (preferred hosted path if you have access):
CORTENSOR_API_KEY=
# Or any other provider OpenMinion supports, for example:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Optional: raises the GitHub API rate limit (60/h unauthenticated). Read only, no scopes needed.
GITHUB_TOKEN=
# Optional: OpenMinion agent id created by `openminion setup --agent ...`
RADAR_AGENT_ID=
