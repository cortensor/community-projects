# One of these enables the live provider path (repo-triager auto-detects them).
# CORTENSOR_API_KEY=          # Cortensor Portal (recommended by the hackathon)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional
# Any OpenAI-compatible endpoint (gateway, local server, hosted proxy):
# OPENAI_COMPATIBLE_BASE_URL=https://example.com/v1
# OPENAI_COMPATIBLE_API_KEY=local
# REPO_TRIAGER_MODEL=model-id

# GITHUB_TOKEN=               # higher read-only rate limits when fetching issues
# REPO_TRIAGER_HOME=./var     # workspace for runs, outbox, cache
# REPO_TRIAGER_PROVIDER=scripted
# REPO_TRIAGER_APPROVE=ask
# REPO_TRIAGER_LOG_LEVEL=WARNING
