{
  "default_agent": "guardian-groq",
  "action_policy": {
    "mode": "auto",
    "default_action": "require_confirm",
    "allow_read_only_without_prompt": true
  },
  "agents": {
    "guardian-groq": {
      "provider": "groq",
      "model": "llama-3.3-70b-versatile",
      "api_key": "env:GROQ_API_KEY",
      "default_channel": "cli"
    }
  }
}
