{
  "default_agent": "guardian-portal",
  "action_policy": {
    "mode": "auto",
    "default_action": "require_confirm",
    "allow_read_only_without_prompt": true
  },
  "agents": {
    "guardian-portal": {
      "provider": "cortensor-portal",
      "model": "oss-20b",
      "api_key": "env:CORTENSOR_API_KEY",
      "base_url": "https://api.cortensor.app/v1",
      "default_channel": "cli"
    }
  }
}
