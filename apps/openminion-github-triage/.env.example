# OpenAI-compatible inference endpoint (Cortensor Portal or compatible provider)
CORTENSOR_BASE_URL=https://api.openai.com/v1
CORTENSOR_API_KEY=your_api_key_here
CORTENSOR_MODEL=openai/gpt-oss-120b

# Optional read-only GitHub token to raise public REST API rate limits
GITHUB_TOKEN=your_github_token_here
